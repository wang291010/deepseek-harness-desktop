{
  "name": "dsh-workbench",
  "version": "0.0.2-yourworkbench.1",
  "description": "Personal workbench for DeepSeek Harness: custom shell with six pages (Agent / Knowledge / Experts / Style / Monitor / Workflows). P0: loading-chain verification.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "main": "lib/host/index.js",
  "scripts": {
    "check": "node --check lib/client.js && eslint lib/client.js",
    "check:eslint": "eslint lib/client.js",
    "test:orchestration": "node tools/smoke-orchestration.mjs",
    "test:orchestration-delivery": "node tools/smoke-orchestration-delivery.mjs",
    "test:gui-orchestration-delivery": "node tools/gui-f1-delivery-e2e.mjs",
    "test:gui-web-parallel": "node tools/gui-f4-web-parallel-e2e.mjs",
    "test:gui-multimodal": "node tools/gui-f5-multimodal-e2e.mjs",
    "test:gui-auto-parallel": "node tools/gui-g1-auto-parallel-e2e.mjs",
    "test:routing": "node tools/smoke-routing.mjs",
    "test:orchestration-jobs": "node tools/smoke-orchestration-jobs.mjs",
    "test:gui-orchestration-jobs": "node tools/gui-f3-job-panel-e2e.mjs",
    "test:worker-failover": "node tools/smoke-worker-failover.mjs",
    "test:dual-track-worktree": "node tools/smoke-dual-track-worktree.mjs",
    "test:style": "node tools/smoke-style.mjs",
    "test:client-load": "node tools/smoke-client-load.mjs",
    "test:watchdog": "node tools/smoke-watchdog.mjs",
    "test:collab": "node tools/smoke-collab.mjs",
    "test:workflow": "node tools/smoke-workflow.mjs",
    "test:memory": "node tools/smoke-memory.mjs",
    "test:knowledge": "node tools/smoke-knowledge.mjs",
    "test:knowledge-auto": "node tools/smoke-knowledge-auto.mjs",
    "test:distill": "node tools/smoke-distill.mjs",
    "test:knowledge-review": "node tools/smoke-knowledge-review.mjs",
    "test:gui-ai-review-job": "node tools/gui-ai-review-job-e2e.mjs",
    "test:gui-knowledge-review": "node tools/gui-knowledge-review-e2e.mjs"
  },
  "exports": {
    ".": "./lib/host/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-primitives"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-client-runtime": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-client-ui-primitives": "^0.1.1-rc.2",
    "react": "^18.3.1"
  },
  "devDependencies": {
    "eslint": "10.8.1",
    "globals": "17.11.0"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.2.0"
  }
}
